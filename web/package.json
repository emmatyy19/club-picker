{
  "name": "club-picker-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test": "vitest run",
    "format": "prettier --write src tests vite.config.ts tsconfig.json package.json index.html offline-plugin.ts",
    "format:check": "prettier --check src tests vite.config.ts tsconfig.json package.json index.html offline-plugin.ts",
    "showcase": "vite --host 127.0.0.1 --port 5174 --strictPort --mode showcase",
    "build:showcase": "tsc -b && vite build --mode showcase --base=./",
    "build:phone": "tsc -b && vite build --mode phone --base=./"
  },
  "dependencies": {
    "@mantine/core": "^8.3.0",
    "@mantine/hooks": "^8.3.0",
    "echarts": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
